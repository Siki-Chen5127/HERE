# 高德开放平台“Android 平台 SDK”Key（绑定包名 com.here 与 APK 签名 SHA1）
EXPO_PUBLIC_AMAP_ANDROID_KEY=

# 高德开放平台“Web 端（JS API）”Key，用于网页地图。与 Web 服务 Key 是不同类型。
EXPO_PUBLIC_AMAP_JS_KEY=
# 可选。生产环境同域 Nginx 代理地址，安全密钥仅保存在服务器。
# EXPO_PUBLIC_AMAP_SERVICE_HOST=https://你的域名/_AMapService

# 高德开放平台“Web 服务”Key，用于逆地理编码等 REST API。
EXPO_PUBLIC_AMAP_WEB_KEY=
EXPO_PUBLIC_HERE_API_URL=http://127.0.0.1:8000/api/v1
# Optional contest demo account (intentionally public, configure on the build machine).
EXPO_PUBLIC_DEMO_STUDENT_PHONE=
EXPO_PUBLIC_DEMO_STUDENT_PASSWORD=
